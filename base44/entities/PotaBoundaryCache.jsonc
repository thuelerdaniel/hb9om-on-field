{
  "name": "PotaBoundaryCache",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "description": "Referenz-Code (z.B. CH-0224 fuer POTA, DLFF-0001 fuer WWFF, LLCH-0002 fuer LLOTA)"
    },
    "program": {
      "type": "string",
      "enum": [
        "pota",
        "wwff",
        "llota"
      ],
      "default": "pota",
      "description": "Programm-Typ: pota, wwff oder llota (gleicher Cache, gleicher API-Endpoint)"
    },
    "boundary": {
      "type": "object",
      "description": "GeoJSON MultiPolygon/Polygon der Grenze von pota-map.fr (Koordinaten [lng, lat]) \u2014 null wenn keine Grenze vorhanden"
    },
    "polygon": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "description": "[lat, lng] Koordinatenpaar"
      },
      "description": "Vereinfachtes Grenzpolygon [lat, lng] Array (max 200 Punkte) \u2014 fuer schnelles Frontend-Rendering"
    },
    "has_boundary": {
      "type": "boolean",
      "default": false,
      "description": "True wenn eine Grenze gefunden wurde, false wenn pota-map.fr null zurueckgab"
    },
    "park_name": {
      "type": "string",
      "description": "Name von pota-map.fr"
    },
    "fetched_date": {
      "type": "string",
      "format": "date-time",
      "description": "Wann die Grenze von pota-map.fr abgerufen wurde"
    }
  },
  "required": [
    "reference"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}