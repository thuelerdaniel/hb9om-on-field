{
  "name": "DxSpot",
  "type": "object",
  "properties": {
    "call": {
      "type": "string",
      "description": "Rufzeichen der gespoteten Station"
    },
    "frequency": {
      "type": "number",
      "description": "Frequenz in kHz"
    },
    "band": {
      "type": "string",
      "description": "Band (z.B. 20m, 40m)"
    },
    "mode": {
      "type": "string",
      "description": "Modulationsart (z.B. FT8, CW, SSB)"
    },
    "country": {
      "type": "string",
      "description": "Land der gespoteten Station (DXCC Entity)"
    },
    "countryCode": {
      "type": "string",
      "description": "Laendercode oder Flag-Emoji der gespoteten Station"
    },
    "source": {
      "type": "string",
      "description": "Hauptdatenquelle (z.B. DX Summit, DXCluster)"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alle Quellen die diesen Spot gemeldet haben"
    },
    "spotter": {
      "type": "string",
      "description": "Rufzeichen des Spotters"
    },
    "age_seconds": {
      "type": "number",
      "description": "Alter des Spots in Sekunden"
    },
    "spot_time": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitpunkt des Spots"
    },
    "confidence": {
      "type": "number",
      "description": "Vertrauensscore 0-100 (Basis 50, +spotter, +locator, +country, +activity)"
    },
    "distance": {
      "type": "number",
      "description": "Distanz zur Station in km"
    },
    "azimuth": {
      "type": "number",
      "description": "Peilung/Azimuth 0-360 Grad"
    },
    "locator": {
      "type": "string",
      "description": "Maidenhead Grid Locator der gespoteten Station (falls im Kommentar vorhanden)"
    },
    "lat": {
      "type": "number",
      "description": "Breitengrad der gespoteten Station (DXCC-Center oder aus Locator)"
    },
    "lng": {
      "type": "number",
      "description": "Laengengrad der gespoteten Station (DXCC-Center oder aus Locator)"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Kommentare/Zusatzinfos zum Spot"
    },
    "activity": {
      "type": "string",
      "description": "Aktivitaet (SOTA, POTA, IOTA, WWFF) falls erkannt"
    },
    "activity_ref": {
      "type": "string",
      "description": "Referenz-Code der Aktivitaet (z.B. W7Y/TT-161, US-2465)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Ob der Spot noch aktiv ist"
    }
  },
  "required": [
    "call",
    "frequency"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}