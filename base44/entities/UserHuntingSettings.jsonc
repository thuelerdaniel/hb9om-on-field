{
  "name": "UserHuntingSettings",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Eindeutige User-ID"
    },
    "selected_activity_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SOTA",
          "POTA",
          "WWFF",
          "WCA",
          "COTA",
          "IOTA",
          "GMA",
          "TOTA",
          "LOTA",
          "MOTA",
          "HEMA"
        ]
      },
      "default": [
        "SOTA",
        "POTA",
        "WWFF",
        "WCA",
        "COTA",
        "IOTA",
        "GMA",
        "TOTA",
        "LOTA",
        "MOTA",
        "HEMA"
      ],
      "description": "Aktive Aktivitaets-Typen"
    },
    "selected_bands": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "80m",
          "40m",
          "20m",
          "15m",
          "10m",
          "6m",
          "2m",
          "70cm"
        ]
      },
      "default": [
        "80m",
        "40m",
        "20m",
        "15m",
        "10m"
      ],
      "description": "Aktive Bnder"
    },
    "selected_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SSB",
          "CW",
          "FT8",
          "FM"
        ]
      },
      "default": [
        "SSB",
        "CW",
        "FT8",
        "FM"
      ],
      "description": "Aktive Modi"
    },
    "max_spot_age_hours": {
      "type": "number",
      "default": 2,
      "description": "Maximales Spot-Alter in Stunden"
    },
    "show_only_swiss": {
      "type": "boolean",
      "default": false,
      "description": "Nur Schweizer Spots anzeigen"
    },
    "sort_by": {
      "type": "string",
      "enum": [
        "time",
        "distance",
        "callsign"
      ],
      "default": "time",
      "description": "Sortierung"
    },
    "filter_distance_km": {
      "type": "number",
      "default": 0,
      "description": "Distanz-Filter in km (0 = alle)"
    },
    "auto_refresh_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Auto-Refresh aktiviert"
    },
    "auto_refresh_interval_sec": {
      "type": "number",
      "default": 60,
      "description": "Auto-Refresh Intervall in Sekunden"
    },
    "ui_settings": {
      "type": "object",
      "properties": {
        "field_widths": {
          "type": "object",
          "description": "Feldbreiten pro Geraet (desktop/tablet/mobile) \u2014 fieldId -> width%"
        },
        "button_positions": {
          "type": "object",
          "description": "Button-Positionen pro Geraet (baseKey -> {x, y})"
        }
      },
      "description": "UI-Einstellungen: Feldbreiten und Button-Positionen pro Geraet"
    },
    "draggable_button_positions": {
      "type": "object",
      "description": "Gespeicherte Positionen verschiebbarer Buttons (buttonId -> {x, y in px relativ zum Viewport)",
      "additionalProperties": true
    },
    "last_user_lat": {
      "type": "number",
      "description": "Letzter Breitengrad des Users"
    },
    "last_user_lng": {
      "type": "number",
      "description": "Letzter Laengengrad des Users"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Letzte Aktualisierung"
    },
    "wavelog_lan_url": {
      "type": "string",
      "description": "Wavelog Server interne LAN-Adresse (z.B. http://192.168.178.146)"
    },
    "wavelog_wan_url": {
      "type": "string",
      "description": "Wavelog Server externe WAN-Adresse (z.B. http://hb3ynf.ddns.net:8080)"
    },
    "wavelog_api_key": {
      "type": "string",
      "description": "Wavelog API Key (Read+Write)"
    },
    "wavelog_station_id": {
      "type": "string",
      "description": "Wavelog Station Profile ID"
    },
    "wavelog_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Wavelog-Integration aktiv"
    },
    "wavelog_auto_sync": {
      "type": "boolean",
      "default": false,
      "description": "Permanent Sync \u2014 QSOs sofort an Wavelog senden"
    },
    "wavelog_last_fetch_id": {
      "type": "number",
      "default": 0,
      "description": "Letzte importierte QSO-ID von Wavelog (fuer Delta-Sync)"
    },
    "wavelog_last_sync": {
      "type": "string",
      "format": "date-time",
      "description": "Letzter erfolgreicher Permanent-Sync Zeitstempel"
    },
    "logging_backend": {
      "type": "string",
      "enum": [
        "qrz",
        "wavelog"
      ],
      "default": "qrz",
      "description": "QSO Logging Backend: qrz (QRZ.com) oder wavelog (eigener Server)"
    },
    "wavelog_offline_queue": {
      "type": "string",
      "description": "JSON Array von QSO-IDs die offline geloggt wurden und noch an Wavelog gesendet werden muessen"
    },
    "sync_paused": {
      "type": "boolean",
      "default": false,
      "description": "Per-User Sync-Stop \u2014 true pausiert den Wavelog-Import fuer diesen User"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}