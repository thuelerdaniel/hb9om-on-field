{
  "name": "Repeater",
  "type": "object",
  "properties": {
    "callsign": {
      "type": "string",
      "description": "Rufzeichen des Relais"
    },
    "frequency": {
      "type": "number",
      "description": "Frequenz in MHz"
    },
    "offset_mhz": {
      "type": "number",
      "description": "Offset in MHz (negativ oder positiv)"
    },
    "tone": {
      "type": "string",
      "description": "Subton / Zugang (CTCSS, DCS, CC, etc.)"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Modulationsarten (FM, Fusion, DMR, D-STAR, P-25, NXDN, M17, EchoLink, WIRES-X)"
    },
    "primary_mode": {
      "type": "string",
      "description": "Hauptmodulationsart fuer Farbgebung"
    },
    "location_name": {
      "type": "string",
      "description": "Standort-Name"
    },
    "country": {
      "type": "string",
      "description": "Land"
    },
    "country_code": {
      "type": "string",
      "description": "Laendercode (z.B. CH, DE, FR)"
    },
    "lat": {
      "type": "number",
      "description": "Breitengrad"
    },
    "lng": {
      "type": "number",
      "description": "Laengengrad"
    },
    "band": {
      "type": "string",
      "description": "Band (10m, 6m, 4m, 2m, 70cm, 23cm)"
    },
    "status": {
      "type": "string",
      "enum": [
        "on-air",
        "off-air",
        "testing",
        "unknown"
      ],
      "default": "unknown",
      "description": "Betriebsstatus"
    },
    "web_url": {
      "type": "string",
      "description": "Web-URL des Relais"
    },
    "echolink_node": {
      "type": "string",
      "description": "EchoLink-Knotennummer"
    },
    "fm_funknetz": {
      "type": "boolean",
      "default": false,
      "description": "Auf FM-Funknetz.de anhoerbar"
    },
    "has_emergency_power": {
      "type": "boolean",
      "default": false,
      "description": "Notstromversorgung vorhanden (Batterie/USV/Solar)"
    },
    "power_source": {
      "type": "string",
      "enum": [
        "netz",
        "notstrom",
        "solar",
        "unknown"
      ],
      "default": "unknown",
      "description": "Stromversorgung (Netz, Notstrom, Solar)"
    },
    "source_id": {
      "type": "string",
      "description": "RepeaterBook-ID"
    },
    "linked_callsigns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Verlinkte Rufzeichen (nur permanente Crosslinks aus RepeaterBook)"
    },
    "coverage_radius_km": {
      "type": "number",
      "description": "Berechnete Abdeckung in km (wird im Hintergrund verfeinert)"
    },
    "coverage_source": {
      "type": "string",
      "enum": [
        "band_estimate",
        "aprs_refined",
        "manual"
      ],
      "default": "band_estimate",
      "description": "Quelle der Abdeckungsdaten"
    },
    "coverage_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Letzte Abdeckungs-Berechnung"
    }
  },
  "required": [
    "callsign",
    "frequency"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}