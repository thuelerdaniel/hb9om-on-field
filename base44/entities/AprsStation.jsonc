{
  "name": "AprsStation",
  "type": "object",
  "properties": {
    "callsign": {
      "type": "string",
      "description": "APRS-Rufzeichen der Station"
    },
    "lat": {
      "type": "number",
      "description": "Breitengrad"
    },
    "lng": {
      "type": "number",
      "description": "Laengengrad"
    },
    "symbol": {
      "type": "string",
      "description": "APRS-Symbol-Code (z.B. /#, /y, /_, /r, /[)"
    },
    "symbol_description": {
      "type": "string",
      "description": "Beschreibung des APRS-Symbols (z.B. Digipeater, WX Station)"
    },
    "station_type": {
      "type": "string",
      "description": "Stations-Typ (digipeater, wx_station, rx_igate, suntracker, repeater, home, node, other)"
    },
    "comment": {
      "type": "string",
      "description": "APRS-Comment der Station",
      "maxLength": 1000
    },
    "last_heard": {
      "type": "string",
      "format": "date-time",
      "description": "Letzter Empfangszeitpunkt (last_heard von aprs.fi)"
    },
    "source_callsign": {
      "type": "string",
      "description": "Quell-Rufzeichen (srccall falls abweichend vom Station-Callsign)"
    },
    "is_swiss": {
      "type": "boolean",
      "default": false,
      "description": "True wenn Schweizer Station (HB9/HB9)"
    }
  },
  "required": [
    "callsign",
    "lat",
    "lng"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}