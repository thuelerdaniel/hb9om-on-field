{
  "name": "AprsStation",
  "type": "object",
  "properties": {
    "callsign": {
      "type": "string",
      "description": "APRS-Rufzeichen der Station"
    },
    "lat": {
      "type": "number",
      "description": "Breitengrad"
    },
    "lng": {
      "type": "number",
      "description": "Laengengrad"
    },
    "symbol": {
      "type": "string",
      "description": "APRS-Symbol-Code (z.B. /#, /y, /_, /r, /[)"
    },
    "station_type": {
      "type": "string",
      "description": "Stations-Typ (digipeater, wx_station, rx_igate, suntracker, repeater, other)"
    },
    "comment": {
      "type": "string",
      "description": "APRS-Comment der Station",
      "maxLength": 1000
    },
    "is_swiss": {
      "type": "boolean",
      "default": false,
      "description": "True wenn Schweizer Station (HB9/HB9)"
    }
  },
  "required": [
    "callsign",
    "lat",
    "lng"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}