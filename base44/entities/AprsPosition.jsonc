{
  "name": "AprsPosition",
  "type": "object",
  "properties": {
    "callsign": {
      "type": "string",
      "description": "Rufzeichen der APRS-Station (z. B. HB9ABC-9)"
    },
    "lat": {
      "type": "number",
      "description": "Breitengrad der letzten Position"
    },
    "lng": {
      "type": "number",
      "description": "Laengengrad der letzten Position"
    },
    "symbol": {
      "type": "string",
      "description": "APRS-Symbol, 2 Zeichen (Tabelle + Code, z. B. '/>' fuer Auto)"
    },
    "station_type": {
      "type": "string",
      "enum": [
        "mobile",
        "fixed",
        "wx",
        "igate",
        "digi",
        "object",
        "balloon",
        "other"
      ],
      "default": "other",
      "enumColors": [
        "blue",
        "gray",
        "purple",
        "teal",
        "green",
        "orange",
        "pink",
        "gray"
      ],
      "description": "Kategorie der Station (aus Symbol und Kommentar abgeleitet)"
    },
    "comment": {
      "type": "string",
      "description": "APRS-Kommentar der Station (max 200 Zeichen)"
    },
    "speed": {
      "type": "number",
      "description": "Geschwindigkeit in km/h (aus Paket oder aus Bewegung abgeleitet)"
    },
    "course": {
      "type": "number",
      "description": "Kurs in Grad (0-359)"
    },
    "altitude": {
      "type": "number",
      "description": "Hoehe in Metern (aus /A=-Kommentar)"
    },
    "srccall": {
      "type": "string",
      "description": "Quelle aus dem Paketkopf (SRC des Pakets SRC>DST,PATH)"
    },
    "dstcall": {
      "type": "string",
      "description": "Ziel-Adresse aus dem Paketkopf (DST), z. B. APDR16 oder APRS"
    },
    "path": {
      "type": "string",
      "description": "Digipeater-Pfad aus dem Paketkopf (z. B. WIDE1-1,WIDE2-1)"
    },
    "phg": {
      "type": "string",
      "description": "PHG-Angabe der Station (Power/Height/Gain/Directivity, z. B. 5130)"
    },
    "status": {
      "type": "string",
      "description": "Status-Text der Station (aus einem Status-Paket, max 120 Zeichen)"
    },
    "wx": {
      "type": "object",
      "description": "Wetterdaten aus dem Paket (wind_dir, wind_kmh, gust_kmh, temp_c, rain_1h_mm, rain_24h_mm, rain_midnight_mm, humidity, pressure_hpa)"
    },
    "aprs_time": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitstempel aus dem Paket (bei / und @ Paketen), sonst leer"
    },
    "last_heard": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitpunkt des letzten empfangenen Pakets"
    },
    "first_heard": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitpunkt des ersten empfangenen Pakets"
    },
    "last_sample_at": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitpunkt des letzten gespeicherten Historien-Samples (begrenzt die Samplerate)"
    },
    "packet_count": {
      "type": "number",
      "default": 1,
      "description": "Anzahl empfangener Pakete seit erstem Hoeren"
    },
    "source": {
      "type": "string",
      "default": "aprs-is",
      "description": "Datenquelle (aprs-is)"
    },
    "last_format": {
      "type": "string",
      "description": "Zuletzt empfangenes Paketformat (uncompressed, compressed, mice)"
    }
  },
  "required": [
    "callsign",
    "lat",
    "lng"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}