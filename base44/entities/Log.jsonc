{
  "name": "Log",
  "type": "object",
  "properties": {
    "callsign": {
      "type": "string",
      "description": "Rufzeichen des QSO-Partners"
    },
    "callsign_suffix": {
      "type": "string",
      "enum": [
        "",
        "/P",
        "/M",
        "/AM",
        "/MM"
      ],
      "default": "",
      "description": "Suffix des QSO-Partners (/P, /M, /AM, /MM)"
    },
    "qso_date": {
      "type": "string",
      "format": "date",
      "description": "Datum des QSO"
    },
    "time_start": {
      "type": "string",
      "description": "Startzeit UTC (HH:MM)"
    },
    "time_end": {
      "type": "string",
      "description": "Endzeit UTC (HH:MM)"
    },
    "frequency": {
      "type": "number",
      "description": "Frequenz in MHz"
    },
    "band": {
      "type": "string",
      "enum": [
        "160m",
        "80m",
        "60m",
        "40m",
        "30m",
        "20m",
        "17m",
        "15m",
        "12m",
        "10m",
        "6m",
        "4m",
        "2m",
        "70cm",
        "23cm",
        "Other"
      ],
      "default": "2m"
    },
    "mode": {
      "type": "string",
      "enum": [
        "SSB",
        "CW",
        "FM",
        "FT8",
        "FT4",
        "PSK",
        "RTTY",
        "AM",
        "Other"
      ],
      "default": "FM"
    },
    "rst_sent": {
      "type": "string",
      "description": "RST gesendet"
    },
    "rst_received": {
      "type": "string",
      "description": "RST erhalten"
    },
    "power": {
      "type": "number",
      "description": "Sendeleistung in Watt"
    },
    "operator_name": {
      "type": "string",
      "description": "Name des QSO-Partners (von QRZ.com)"
    },
    "operator_address": {
      "type": "string",
      "description": "Adresse des QSO-Partners (von QRZ.com)"
    },
    "operator_country": {
      "type": "string",
      "description": "Land des QSO-Partners (von QRZ.com)"
    },
    "operator_grid": {
      "type": "string",
      "description": "Maidenhead Grid Locator des QSO-Partners"
    },
    "operator_email": {
      "type": "string",
      "description": "E-Mail des QSO-Partners (von QRZ.com)"
    },
    "is_clubstation": {
      "type": "boolean",
      "default": false,
      "description": "Loggen fuer Clubstation"
    },
    "club_callsign": {
      "type": "string",
      "description": "Rufzeichen der Clubstation (z.B. HB9OM)"
    },
    "club_operator_callsign": {
      "type": "string",
      "description": "Operator Rufzeichen (bei Clubstation)"
    },
    "club_operator_name": {
      "type": "string",
      "description": "Operator Name (bei Clubstation)"
    },
    "my_reference": {
      "type": "string",
      "description": "Meine Referenz (z.B. HB/AG-001)"
    },
    "my_reference_type": {
      "type": "string",
      "enum": [
        "sota",
        "pota",
        "hbff",
        "wwbota",
        "castle",
        "iota",
        "lighthouse",
        "repeater",
        "tota",
        "aprs",
        "swiss_protected",
        "generell",
        "custom"
      ],
      "default": "custom"
    },
    "my_reference_name": {
      "type": "string",
      "description": "Name meiner Referenz"
    },
    "my_suffix": {
      "type": "string",
      "enum": [
        "",
        "/P",
        "/M",
        "/AM",
        "/MM",
        "/QRP",
        "/A"
      ],
      "default": "",
      "description": "Mein Suffix (/P, /M, /AM, /MM, /QRP, /A)"
    },
    "my_country_prefix": {
      "type": "string",
      "description": "Laendercode des Gastlandes (z.B. DE, FR) wenn im Ausland gefunkt wird \u2014 CEPT-Praefix"
    },
    "my_country_name": {
      "type": "string",
      "description": "Name des Gastlandes (z.B. Deutschland)"
    },
    "my_license_class": {
      "type": "string",
      "enum": [
        "full",
        "novice"
      ],
      "description": "Lizenzklasse bei Auslandsbetrieb (Full/Novice)"
    },
    "my_grid": {
      "type": "string",
      "description": "Mein Maidenhead Locator (bei Generell)"
    },
    "notes": {
      "type": "string",
      "description": "Notizen zum QSO"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "callsign",
    "qso_date",
    "frequency",
    "mode"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}