{
  "name": "WwffPoint",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "WWFF Reference (z.B. DLFF-0123, HBFF-0001)"
    },
    "name": {
      "type": "string",
      "description": "Naturschutzgebiet-Name"
    },
    "lat": {
      "type": "number",
      "description": "Breitengrad"
    },
    "lng": {
      "type": "number",
      "description": "Laengengrad"
    },
    "country_code": {
      "type": "string",
      "description": "Laendercode (z.B. DE, CH, FR) \u2014 abgeleitet aus WWFF-Code"
    },
    "park_type": {
      "type": "string",
      "description": "Schutzgebiets-Typ (z.B. WWFF, Nationalpark)"
    },
    "link": {
      "type": "string",
      "description": "Web-Link zum Gebiet"
    },
    "boundary": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "description": "[lat, lng] Koordinatenpaar"
      },
      "description": "Vereinfachtes Grenzpolygon [lat, lng] Array (max 200 Punkte) \u2014 Quelle: pota-map.fr"
    },
    "boundary_source": {
      "type": "string",
      "enum": [
        "pota-map-fr",
        "openstreetmap-nominatim",
        "openstreetmap-overpass"
      ],
      "description": "Quelle des Grenzpolygons"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time",
      "description": "Letzte Synchronisation"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung",
      "maxLength": 1000
    }
  },
  "required": [
    "code",
    "lat",
    "lng"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}