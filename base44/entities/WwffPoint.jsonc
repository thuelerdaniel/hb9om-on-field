{
  "name": "WwffPoint",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "WWFF Reference (z.B. DLFF-0123)"
    },
    "name": {
      "type": "string",
      "description": "Naturschutzgebiet-Name"
    },
    "lat": {
      "type": "number",
      "description": "Breitengrad"
    },
    "lng": {
      "type": "number",
      "description": "Laengengrad"
    },
    "link": {
      "type": "string",
      "description": "Web-Link zum Gebiet"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung",
      "maxLength": 1000
    }
  },
  "required": [
    "code",
    "lat",
    "lng"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}