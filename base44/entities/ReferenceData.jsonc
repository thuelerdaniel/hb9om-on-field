{
  "name": "ReferenceData",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "sota",
        "pota",
        "hbff",
        "wwbota",
        "castle",
        "castle_overpass",
        "lighthouse",
        "iota",
        "repeater",
        "aprs",
        "tota",
        "llota"
      ],
      "description": "Referenz-Typ"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array der zwischengespeicherten Referenzdaten (bei repeater/aprs/tota: Metadaten-Objekt mit withCoords/withoutCoords)"
    },
    "total_count": {
      "type": "number",
      "description": "Anzahl der Referenzen (vom Backend beim Refresh gesetzt \u2014 stabile, autoritative Gesamtzahl)"
    },
    "source": {
      "type": "string",
      "description": "Datenquelle"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Letzte Aktualisierung"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung",
      "maxLength": 1000
    }
  },
  "required": [
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}