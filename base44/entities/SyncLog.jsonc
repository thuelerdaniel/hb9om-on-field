{
  "name": "SyncLog",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitpunkt der Aktualisierung"
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "description": "Gesamtstatus der Aktualisierung"
    },
    "total_duration_ms": {
      "type": "number",
      "description": "Gesamtdauer in Millisekunden"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Ergebnisse pro Referenz-Typ"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "scheduled",
        "manual"
      ],
      "description": "Ausloeser der Aktualisierung"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung",
      "maxLength": 1000
    }
  },
  "required": [
    "timestamp",
    "overall_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}