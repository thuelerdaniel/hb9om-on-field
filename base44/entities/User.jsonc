{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitpunkt der letzten Anmeldung"
    },
    "qrz_username": {
      "type": "string",
      "description": "QRZ.com Benutzername (pers\u00f6nlich, f\u00fcr nicht-Admin/Demo User)"
    },
    "qrz_password": {
      "type": "string",
      "description": "QRZ.com Passwort (pers\u00f6nlich, f\u00fcr nicht-Admin/Demo User)"
    },
    "aprs_fi_api_key": {
      "type": "string",
      "description": "Pers\u00f6nlicher APRS.fi API-Key"
    },
    "brandmeister_api_key": {
      "type": "string",
      "description": "Pers\u00f6nlicher BrandMeister API-Key (nur Admins)"
    },
    "use_global_keys": {
      "type": "boolean",
      "default": true,
      "description": "Ob Admin globale API-Keys (QRZ, APRS.fi, BrandMeister) verwenden soll \u2014 false = pers\u00f6nliche Keys verwenden"
    },
    "admin_email_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Ob dieser Admin den t\u00e4glichen Report per E-Mail erhalten m\u00f6chte"
    },
    "admin_email_override": {
      "type": "string",
      "description": "Separate E-Mail-Adresse f\u00fcr t\u00e4glichen Report (leer = Account-E-Mail verwenden)"
    },
    "admin_email_verified": {
      "type": "boolean",
      "default": false,
      "description": "Ob die separate E-Mail-Adresse verifiziert wurde"
    },
    "donation_hidden": {
      "type": "boolean",
      "default": false,
      "description": "Ob das Spenden-Popup f\u00fcr diesen User dauerhaft ausgeblendet ist (Admin setzt)"
    },
    "donation_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Ob ein Admin best\u00e4tigt hat dass der User gespendet hat \u2014 wenn true wird donation_hidden automatisch auch true"
    },
    "donation_email": {
      "type": "string",
      "description": "E-Mail die der User im Spenden-Popup angegeben hat"
    },
    "donation_shown_today": {
      "type": "number",
      "default": 0,
      "description": "Z\u00e4hler wie oft das Popup heute schon angezeigt wurde (Tages-Reset)"
    },
    "donation_last_show_date": {
      "type": "string",
      "description": "Datum des letzten Anzeige-Tages (f\u00fcr Tages-Reset, YYYY-MM-DD)"
    },
    "donation_total_shown": {
      "type": "number",
      "default": 0,
      "description": "Gesamtz\u00e4hler aller Popup-Anzeigen"
    },
    "last_donation_prompt": {
      "type": "string",
      "format": "date-time",
      "description": "Letzter Zeitpunkt der Spenden-Popup-Anzeige"
    },
    "donation_count": {
      "type": "number",
      "default": 0,
      "description": "Anzahl wie oft das Spenden-Popup angezeigt wurde (legacy \u2014 durch donation_total_shown ersetzt)"
    },
    "donation_thanks_email_sent": {
      "type": "boolean",
      "default": false,
      "description": "Ob bereits eine Dankes-E-Mail gesendet wurde (Duplikat-Schutz \u2014 einmal true, wird nie wieder gesendet)"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}