{
  "name": "PotaPoint",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "POTA Reference (z.B. PA-0123)"
    },
    "name": {
      "type": "string",
      "description": "Parkname"
    },
    "lat": {
      "type": "number",
      "description": "Breitengrad"
    },
    "lng": {
      "type": "number",
      "description": "Laengengrad"
    },
    "parkType": {
      "type": "string",
      "description": "Park-Typ (z.B. National Park, State Park)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Ob der Park aktiv ist"
    },
    "boundary": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "description": "[lat, lng] Koordinatenpaar"
      },
      "description": "Park-Grenzpolygon (vereinfacht, max 200 Punkte) \u2014 [lat, lng] Array. Quelle: pota-map.fr (weltweit, bevorzugt) oder OSM Nominatim/Overpass oder SwissTopo BLN (Schweiz, Legacy)"
    },
    "boundary_source": {
      "type": "string",
      "enum": [
        "pota-map-fr",
        "openstreetmap-nominatim",
        "openstreetmap-overpass",
        "openstreetmap-overpass-nearest",
        "swisstopo-bln",
        "swisstopo-biotop",
        "swisstopo-moor",
        "swisstopo-auen"
      ],
      "description": "Quelle des Grenzpolygons"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung",
      "maxLength": 1000
    }
  },
  "required": [
    "code",
    "lat",
    "lng"
  ],
  "rls": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  }
}