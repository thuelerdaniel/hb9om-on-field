{
  "name": "DailyRefreshSchedule",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "sota",
        "pota",
        "hbff",
        "wwbota",
        "castle",
        "lighthouse",
        "lighthouse_eu_north",
        "lighthouse_eu_central",
        "lighthouse_eu_south",
        "lighthouse_eu_east",
        "lighthouse_na_east",
        "lighthouse_na_west",
        "lighthouse_na_central",
        "lighthouse_caribbean",
        "lighthouse_sa",
        "lighthouse_africa",
        "lighthouse_meast",
        "lighthouse_sasia",
        "lighthouse_easia",
        "lighthouse_seasia",
        "lighthouse_oceania",
        "iota",
        "aprs",
        "repeater",
        "repeater_eu_priority1",
        "repeater_eu_priority2",
        "repeater_uk",
        "repeater_na_us",
        "repeater_na_ca",
        "repeater_world",
        "repeater_world_asia",
        "repeater_world_sa",
        "repeater_world_africa",
        "repeater_world_oceania",
        "tota",
        "fm_funknetz",
        "ch_repeater_links"
      ],
      "description": "Datenquelle"
    },
    "label": {
      "type": "string",
      "description": "Anzeigename der Quelle"
    },
    "sync_type": {
      "type": "string",
      "enum": [
        "full_batch",
        "partial",
        "daily"
      ],
      "default": "full_batch",
      "description": "Sync-Typ: full_batch (Mo Voll-Batch), partial (Do Teil-Sync Relais), daily (taeglich APRS)"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Ob diese Quelle automatisch aktualisiert wird (legacy \u2014 durch weekly_enabled ersetzt)"
    },
    "weekly_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Ob diese Quelle im Wochen-Sync aktiv ist"
    },
    "weekly_days": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday"
        ]
      },
      "default": [
        "Monday"
      ],
      "description": "Wochentage an denen diese Quelle synchronisiert wird"
    },
    "incremental_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Ob inkrementeller Sync aktiviert ist (nur Deltas laden statt Voll-Sync)"
    },
    "function_name": {
      "type": "string",
      "description": "Name der Backend-Funktion die aufgerufen wird"
    },
    "function_payload": {
      "type": "object",
      "description": "Payload fuer den Funktionsaufruf"
    },
    "scheduled_time_utc": {
      "type": "string",
      "description": "Geplante UTC-Zeit heute (HH:MM) \u2014 Referenz, nicht mehr aktiv verwendet"
    },
    "next_run_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Naechste geplante Ausfuehrung (ISO datetime)"
    },
    "last_run_time": {
      "type": "string",
      "format": "date-time",
      "description": "Letzte Ausfuehrung"
    },
    "last_status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "success",
        "failed",
        "skipped",
        "timeout"
      ],
      "default": "pending",
      "description": "Status der letzten Ausfuehrung"
    },
    "last_count": {
      "type": "number",
      "description": "Anzahl geladener Eintraege"
    },
    "last_duration_ms": {
      "type": "number",
      "description": "Dauer der letzten Ausfuehrung in ms"
    },
    "last_error": {
      "type": "string",
      "description": "Kurze Fehlermeldung"
    },
    "last_error_detail": {
      "type": "string",
      "description": "Detaillierte Fehlerbeschreibung fuer Admins (Stack Trace, HTTP Status, Response Body)"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Anzeigereihenfolge in der UI"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung",
      "maxLength": 1000
    }
  },
  "required": [
    "source",
    "function_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}