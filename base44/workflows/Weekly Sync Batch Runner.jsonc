      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 1-5 * * 1,4",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
