{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_aprs_station_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fetchAprsStations",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "description": "Inkrementelle APRS-Station-Synchronisation \u00fcber aprs.fi API. L\u00e4uft zweimal t\u00e4glich (06:30 und 18:30 UTC). Jeder Lauf frischt 300 Bestands-Stationen aus der Datenbank auf (last_heard, Position, Comment) und sucht zus\u00e4tzlich 200 Seed-Callsigns nach neuen Stationen ab \u2192 jede Station ist innerhalb von 12 Stunden wieder aktuell.",
  "name": "Daily APRS Station Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 6,18 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "fetchAprsStations"
  }
}