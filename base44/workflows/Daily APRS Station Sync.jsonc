{
  "name": "Daily APRS Station Sync",
  "description": "Inkrementelle APRS-Station-Synchronisation \u00fcber aprs.fi API. L\u00e4uft t\u00e4glich um 06:30 UTC (nach dem Haupt-Batch). Verarbeitet 600 Callsigns pro Lauf \u2192 17.925 Seed in ~30 Tagen.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 6 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_aprs_station_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fetchAprsStations",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "fetchAprsStations"
  }
}