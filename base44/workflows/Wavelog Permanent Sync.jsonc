{
  "name": "Wavelog Permanent Sync",
  "description": "Importiert neue QSOs von Wavelog und exportiert ungesyncte QSOs an Wavelog f\u00fcr alle User mit wavelog_auto_sync=true. L\u00e4uft alle 15 Minuten.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-28T20:31:27.510000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "wavelog_permanent_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "wavelogApi",
            "args": {
              "action": "permanent_sync",
              "internal_secret": "Hb9Om-0nF1eLd-1nt3rn4l-5ync-5ecr3t-2026-v1a9z7k3m2"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "wavelogApi"
  }
}